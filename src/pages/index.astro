---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import ViewToggle from '../components/ViewToggle.astro';
import Timeline from '../components/Timeline.astro';
import { sortByOrder } from '../utils/projects';
const projects = await getCollection('projects');
// Gallery order: the featured five first, the rest alphabetically.
const ordered = sortByOrder(projects, ['antikythera', 'cosmic-drift', 'strength-path', 'tavernborn', 'hud-portfolio']);
const sections = [{id:'all',label:'All projects'},{id:'games',label:'Games'},{id:'web',label:'Web'},{id:'mobile-apps',label:'Apps'},{id:'experiments',label:'Experiments'}]
  .map(section => { const count = section.id === 'all' ? projects.length : projects.filter(p => p.data.section === section.id).length; return { ...section, count, name: `${section.label}, ${count} ${count === 1 ? 'project' : 'projects'}` }; });
---
<Layout title="Cameron Loveland, project showcase" description="Side projects by software engineer Cameron Loveland, some finished, most in progress: games, apps and experiments. Browse the gallery or follow the project timeline.">
  <div class="work-heading"><h2 class="collection-title">Projects</h2></div>
  <div class="work-toolbar">
    <div class="category-filter" role="group" aria-label="Project category">{sections.map(({id,label,count,name}) => <button type="button" data-category={id} aria-pressed={id === 'all'} aria-label={name} disabled>{label}<span aria-hidden="true">{count}</span></button>)}</div>
    <ViewToggle />
  </div>
  <p class="sr-only" id="results-status" role="status" aria-live="polite"></p>
  <div class="gallery" id="gallery-panel" data-view-panel="grid" role="region" aria-label="Project gallery">{ordered.map((project,index) => <Card project={project} index={index} />)}</div>
  <Timeline projects={projects} />
  <div class="empty-state" hidden><h3>Nothing here yet</h3><p>No projects in this category so far. The rest of the collection is one click away.</p><button type="button" data-reset>View all projects</button></div>
  <noscript><p class="no-script-note">You are viewing the full gallery. Enable JavaScript to switch views and categories.</p></noscript>
</Layout>
