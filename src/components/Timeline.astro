---
import ExternalLinkIcon from './ExternalLinkIcon.astro';
import type { CollectionEntry } from 'astro:content';
import { monthIndex, monthFromIndex, formatMonthShort, formatMonthIndex, isoMonth, monthsInclusive } from '../utils/formatDate';
import { linkLabel } from '../utils/linkLabel';
import { sectionLabel } from '../utils/projects';
interface Props { projects: CollectionEntry<'projects'>[]; }
const { projects } = Astro.props;

// The scale: one row per month from the earliest start to the current month
// (or the latest date in the data, if that is later). Oldest at the top, so
// time runs down the page and every rod grows toward the Now line at the foot.
const today = new Date();
const nowMonth = monthIndex(new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), 1)));
const sorted = [...projects].sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf() || a.data.title.localeCompare(b.data.title));
// With nothing to show the scale is one month wide, the current one; the panel then holds only the empty state.
const firstMonth = sorted.length ? Math.min(nowMonth, ...sorted.map(p => monthIndex(p.data.startDate))) : nowMonth;
const lastMonth = Math.max(nowMonth, ...sorted.map(p => monthIndex(p.data.updatedDate ?? p.data.startDate)));
const rows = monthsInclusive(firstMonth, lastMonth);

// Each project is a rod from its start month to the month it was last updated,
// or to now while it is still in progress. Every project has a lane of its
// own, oldest start leftmost, like branches in a git graph: rods never share
// a lane, so nothing overlaps and a hidden rod leaves its lane empty.
const entries = sorted.map((project, lane) => {
  const { startDate, updatedDate, unpublished } = project.data;
  const start = monthIndex(startDate);
  // A rod never runs backwards: work planned for a coming month shows as one month at its start.
  const end = Math.max(start, unpublished ? nowMonth : monthIndex(updatedDate ?? startDate));
  return { project, start, end, lane, row: start - firstMonth + 1, rodRows: monthsInclusive(start, end), label: 0, labelSm: 0 };
});
const lanes = entries.length;
const categories = ['games', 'web', 'mobile-apps', 'experiments', 'prototypes'] as const;

// Every month row is the same height, so the scale stays one scale. A label
// needs a window of whole months: two on wide screens, three on narrow ones
// where the entry stacks into one column (the pitch, with --month-h in the
// CSS). A label sits at its start month unless an earlier label's window
// still covers it; then it moves down its rod a month at a time until it is
// clear, and a spur ties it back to the rod. So consecutive labels are never
// closer than a pitch, whether or not they share a start month. The CSS moves
// a label back to its month when the filter hides everything above it.
const windows = { wide: 2, narrow: 3 };
let taken = 1 - windows.wide;
entries.forEach(entry => { entry.label = Math.max(entry.row, taken + windows.wide); taken = entry.label; });
taken = 1 - windows.narrow;
entries.forEach(entry => { entry.labelSm = Math.max(entry.row, taken + windows.narrow); taken = entry.labelSm; });

// When several projects start in the last few months their labels cascade
// past Now. The grid grows by as many spare rows as the last label's window
// needs, so labels never spill onto what follows the panel. Spare rows carry
// no tick and no year; the spine and the Now line stop at the last real month.
const spare = (window: number, at: (e: typeof entries[number]) => number) =>
  Math.max(0, ...entries.map(e => at(e) + window - 1 - rows));
const gridRows = rows + spare(windows.wide, e => e.label);
const gridRowsSm = rows + spare(windows.narrow, e => e.labelSm);
// Each entry also says which row its label window ends on, so the filter
// (ViewToggle) can shrink the grid back to what the entries still showing need.
const need = (e: typeof entries[number]) => ({ wide: e.label + windows.wide - 1, narrow: e.labelSm + windows.narrow - 1 });

const ticks = Array.from({ length: rows }, (_, i) => {
  const index = firstMonth + i;
  const { year, month } = monthFromIndex(index);
  return { row: i + 1, year, yearStart: month === 0 || i === 0, label: formatMonthShort(index) };
});
---
<div id="timeline-panel" class="project-timeline" data-view-panel="timeline" role="region" aria-label="Projects by start date" hidden>
  <p class="timeline-intro">{rows} months on one scale, oldest first. Each project has its own rod, in its category's color, from the month it started to the month it was last updated, or dashed on to now while it is still in progress.</p>
  {/* The legend is a hint, not a control: the filter row above already filters. */}
  <ul class="timeline-legend" aria-label="Rod colors by category">
    {categories.map(section => <li data-legend={section}><span class="legend-rod" aria-hidden="true"></span>{sectionLabel(section)}</li>)}
  </ul>
  <div class="timeline-scale" data-months={rows} style={`--rows:${gridRows};--rows-sm:${gridRowsSm};--now-row:${rows};--lanes:${lanes}`}>
    <span class="scale-spine" aria-hidden="true"></span>
    {ticks.map(tick => <>
      {tick.yearStart && <span class="scale-year" style={`--row:${tick.row}`} aria-hidden="true">{tick.year}</span>}
      <span class:list={['scale-tick', { 'scale-tick--major': tick.yearStart }]} style={`--row:${tick.row}`} aria-hidden="true">{tick.label}</span>
    </>)}
    <span class="scale-now" aria-hidden="true"><svg class="scale-now-hand" viewBox="0 0 8 8"><path d="M0 0l8 4-8 4z"/></svg><span>Now</span></span>
    <ol class="timeline-entries">
      {entries.map(({ project, start, end, lane, row, rodRows, label, labelSm }) => {
        const { title, links, section, unpublished, commits } = project.data;
        const primary = links.find(l => l.primary) || links[0];
        // A single-month rod already says "Sep 2026", so the count only appears
        // once there is a span to count. In progress always counts, "so far".
        const months = monthsInclusive(start, end);
        const span = `${months} ${months === 1 ? 'month' : 'months'}`;
        const note = [
          unpublished ? `${span} so far` : months > 1 ? span : '',
          commits ? `${commits} commits` : '',
        ].filter(Boolean).join(', ');
        // --kn and --kn-sm: how many months the label sits below its start.
        const style = `--r0:${row};--r1:${row + rodRows};--rod-rows:${rodRows};--lane:${lane};--kn:${label - row};--kn-sm:${labelSm - row}`;
        const rowsNeeded = need({ project, start, end, lane, row, rodRows, label, labelSm });
        return <li class:list={['timeline-entry', { 'timeline-entry--progress': unpublished }]} data-project-category={section} data-need={rowsNeeded.wide} data-need-sm={rowsNeeded.narrow} style={style}>
          <span class="entry-band" aria-hidden="true"></span>
          <span class="entry-rod" aria-hidden="true"><span class="entry-rod-end"></span></span>
          {(label !== row || labelSm !== row) && <span class="entry-spur" aria-hidden="true"></span>}
          <div class="entry-text">
            <div class="entry-name">
              <h3>{title}</h3>
              <p class="entry-kicker"><span>{sectionLabel(section)}</span><span class:list={['status', {'status--progress': unpublished}]}>{unpublished ? 'In progress' : 'Live'}</span></p>
            </div>
            <p class="entry-when"><span class="entry-range">{unpublished
                ? <>Since <time datetime={isoMonth(start)}>{formatMonthIndex(start)}</time></>
                : end > start
                  ? <><time datetime={isoMonth(start)}>{formatMonthIndex(start)}</time> to <time datetime={isoMonth(end)}>{formatMonthIndex(end)}</time></>
                  : <time datetime={isoMonth(start)}>{formatMonthIndex(start)}</time>}</span>{note && <span class="entry-note">{note}</span>}</p>
            {primary && <a class="entry-open" href={primary.href} target="_blank" rel="noopener noreferrer" aria-label={`${linkLabel(primary.label, section)}: ${title} (opens in a new tab)`}>{linkLabel(primary.label, section)}<ExternalLinkIcon /></a>}
          </div>
        </li>;
      })}
    </ol>
  </div>
</div>
