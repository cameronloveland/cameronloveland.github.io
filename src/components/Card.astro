---
import ExternalLinkIcon from './ExternalLinkIcon.astro';
import { linkLabel } from '../utils/linkLabel';
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; index?: number; }
const { project, index = 0 } = Astro.props;
const { title, description, links, image, unpublished, section, stack } = project.data;
const primary = links.find(l => l.primary) || links[0];
const labels = {games:'Game',web:'Interactive web','mobile-apps':'Mobile app',experiments:'Experiment'};
---
<article class:list={['project-card', `project-${project.id}`, {'project-card--wide': index % 4 === 0 || index % 4 === 3}]} data-project-category={section}>
  <div class="project-media">
    {image ? <img src={image} alt={`${title} screenshot`} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" width="1200" height="750" /> : <div class="image-fallback">{title}</div>}
    <span class="media-category">{labels[section]}</span>
    {primary && <a class="media-link" href={primary.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${title} ${primary.label} (opens in a new tab)`}><span class="launch-arrow"><ExternalLinkIcon /></span></a>}
  </div>
  <div class="project-body">
    <div class="project-title-row"><h3>{title}</h3><span class:list={['status',{'status--progress':unpublished}]}>{unpublished ? 'In progress' : 'Live'}</span></div>
    <p>{description}</p>
    <div class="project-bottom"><div class="stack-tags">{stack.map(tag => <span>{tag}</span>)}</div><div class="project-links">{links.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer">{linkLabel(link.label, section)}<ExternalLinkIcon /></a>)}</div></div>
  </div>
</article>
