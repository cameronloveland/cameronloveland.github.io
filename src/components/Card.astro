---
import ExternalLinkIcon from './ExternalLinkIcon.astro';
import { linkLabel } from '../utils/linkLabel';
import { sectionLabel } from '../utils/projects';
import { formatMonthYear } from '../utils/formatDate';
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; index?: number; }
const { project, index = 0 } = Astro.props;
const { title, description, links, image, imageFocus, unpublished, section, stack, languages, startDate, updatedDate, commits } = project.data;
// One way to open a project: the primary link stretches over the whole card.
// Any other links (source, hackathon page) stay as plain text links beside it.
const primary = links.find(l => l.primary) || links[0];
const secondary = links.filter(l => l !== primary);
const isGooglePlay = (link: typeof primary) => link != null && link.label.trim().toLowerCase() === 'google play';
const updated = updatedDate && updatedDate.valueOf() !== startDate.valueOf() ? updatedDate : undefined;
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---
{/* The stable view-transition-name lets a filter move the card to its new slot rather than redraw it. */}
<article class:list={['project-card', `project-${project.id}`]} data-project-category={section} style={`view-transition-name:card-${project.id}`}>
  <div class="project-media" style={imageFocus && `--focus:${imageFocus}`}>
    {image ? <img src={image} alt={`${title} screenshot`} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" width="1200" height="750" /> : <div class="image-fallback">{title}</div>}
  </div>
  <div class="project-body">
    <div class="project-copy">
      <p class="project-kicker"><span>{sectionLabel(section)}</span><span class:list={['status', {'status--progress': unpublished}]}>{unpublished ? 'Under development' : 'Live'}</span></p>
      <h3>{title}</h3>
      <p>{description}</p>
    </div>
    <dl class="project-plate">
      {languages.length > 0 && <><dt>Languages</dt><dd>{languages.map(language => <span class="project-lang" style={`--lang-color:${language.color}`}>{language.name}</span>)}</dd></>}
      {stack.length > 0 && <><dt>Stack</dt><dd>{stack.join(', ')}</dd></>}
      <dt>Started</dt>
      <dd><time datetime={isoDate(startDate)}>{formatMonthYear(startDate)}</time>{updated && <>, updated <time datetime={isoDate(updated)}>{formatMonthYear(updated)}</time></>}</dd>
      {commits !== undefined && <><dt>Commits</dt><dd>{commits}</dd></>}
    </dl>
    {links.length > 0 && <div class="project-actions">
      {primary && (isGooglePlay(primary)
        ? <a class="project-open project-open--badge" href={primary.href} target="_blank" rel="noopener noreferrer" aria-label={`Get it on Google Play: ${title} (opens in a new tab)`}><img src="/images/google-play-badge.webp" alt="Get it on Google Play" width="646" height="250" loading="lazy" decoding="async" /><ExternalLinkIcon /></a>
        : <a class="project-open" href={primary.href} target="_blank" rel="noopener noreferrer" aria-label={`${linkLabel(primary.label, section)}: ${title} (opens in a new tab)`}>{linkLabel(primary.label, section)}<ExternalLinkIcon /></a>)}
      {secondary.map(link => isGooglePlay(link)
        ? <a class="project-more project-more--badge" href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`Get it on Google Play: ${title} (opens in a new tab)`}><img src="/images/google-play-badge.webp" alt="Get it on Google Play" width="646" height="250" loading="lazy" decoding="async" /><ExternalLinkIcon /></a>
        : <a class="project-more" href={link.href} target="_blank" rel="noopener noreferrer">{linkLabel(link.label, section)}<ExternalLinkIcon /></a>)}
    </div>}
  </div>
</article>
