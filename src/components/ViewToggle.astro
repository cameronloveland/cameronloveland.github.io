---
---
<div class="view-toggle" role="group" aria-label="View mode">
  <button type="button" class="view-toggle-btn active" data-view="timeline">
    <svg class="view-toggle-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <line x1="3" y1="1.5" x2="3" y2="14.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
      <circle cx="3" cy="3.5" r="1.6" fill="currentColor" />
      <circle cx="3" cy="8" r="1.6" fill="currentColor" />
      <circle cx="3" cy="12.5" r="1.6" fill="currentColor" />
      <line x1="6.5" y1="3.5" x2="14" y2="3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
      <line x1="6.5" y1="8" x2="14" y2="8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
      <line x1="6.5" y1="12.5" x2="14" y2="12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    </svg>
    Timeline
  </button>
  <button type="button" class="view-toggle-btn" data-view="grid">
    <svg class="view-toggle-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <rect x="1.5" y="1.5" width="5.5" height="5.5" rx="1.2" fill="currentColor" />
      <rect x="9" y="1.5" width="5.5" height="5.5" rx="1.2" fill="currentColor" />
      <rect x="1.5" y="9" width="5.5" height="5.5" rx="1.2" fill="currentColor" />
      <rect x="9" y="9" width="5.5" height="5.5" rx="1.2" fill="currentColor" />
    </svg>
    Grid
  </button>
</div>
<script is:inline>
  (function () {
    var buttons = document.querySelectorAll('.view-toggle-btn');

    buttons.forEach(function (button) {
      button.addEventListener('click', function () {
        var view = button.getAttribute('data-view');
        var sidebar = document.querySelector('.sidebar');
        var gridView = document.querySelector('[data-view-panel="grid"]');
        var timelineView = document.querySelector('[data-view-panel="timeline"]');

        buttons.forEach(function (b) { b.classList.remove('active'); });
        button.classList.add('active');

        if (view === 'timeline') {
          gridView.hidden = true;
          timelineView.hidden = false;
          if (sidebar) sidebar.hidden = true;
        } else {
          gridView.hidden = false;
          timelineView.hidden = true;
          if (sidebar) sidebar.hidden = false;
        }
      });
    });
  }());
</script>
