---
import { getCollection } from 'astro:content';
import { featured, bodyStep } from '../utils/projects';
// The maker's mark: the instrument in miniature. A ring (the arc), a core (the
// stage) and one body (the active project) that turns about the ring as the
// reel advances (.mark-body in portfolio.css rotates it by --reel-index steps).
// The graduations are the featured projects' places on the arc, one step
// apart clockwise from the body's home at the top right, so the body sits on
// a graduation whenever a slide is up.
interface Props { class?: string; }
const { class: className } = Astro.props;
const count = featured(await getCollection('projects')).length;
const home = -50;
const stepDeg = bodyStep(count) / 100 * 360;
const point = (r: number, deg: number) => { const a = deg * Math.PI / 180; return { x: (14 + r * Math.cos(a)).toFixed(2), y: (14 + r * Math.sin(a)).toFixed(2) }; };
const ticks = Array.from({ length: count }, (_, i) => ({ from: point(8.2, home + i * stepDeg), to: point(10.2, home + i * stepDeg) }));
---
<svg class={className} viewBox="0 0 28 28" aria-hidden="true" focusable="false">
  <circle cx="14" cy="14" r="11"/>
  {ticks.map(tick => <line class="mark-tick" x1={tick.from.x} y1={tick.from.y} x2={tick.to.x} y2={tick.to.y}/>)}
  <circle class="mark-core" cx="14" cy="14" r="2.6"/>
  <circle class="mark-body" cx="21.07" cy="5.57" r="2"/>
</svg>
