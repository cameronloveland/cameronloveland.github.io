---
import ExternalLinkIcon from './ExternalLinkIcon.astro';
import { ctaLabel } from '../utils/linkLabel';
import { getCollection } from 'astro:content';
const order = ['antikythera', 'strength-path', 'cosmic-drift', 'tavernborn', 'hud-portfolio'];
const projects = (await getCollection('projects')).filter(p => p.data.image);
const rank = (id: string) => order.includes(id) ? order.indexOf(id) : order.length;
projects.sort((a,b) => rank(a.id) - rank(b.id) || a.data.title.localeCompare(b.data.title));
const categories = {games:'Game',web:'Interactive web','mobile-apps':'Mobile app',experiments:'Experiment'};
const count = projects.length;
// Past seven bodies the arc is crowded: only the active body and its two
// neighbours show their titles; the rest name themselves to screen readers.
const dense = count > 7;

// Instrument geometry. The arc is drawn in a 1000 by 100 box that stretches to
// the arc's real width (the stroke stays one pixel), so every position is a
// share of the box: bodies sit evenly from bodyA to bodyB of the width, and
// each one's height (--y, a share of the arc's height) is where the arc
// passes. The arc runs from arcEnd at both edges down to arcDip in the
// middle; the hand on the rail takes the same shares, so it always sits over
// the active body. --share is the body's place along the run, 0 to 1.
const bodyA = 9, bodyB = 91, arcEnd = 18, arcDip = 52;
const step = count > 1 ? (bodyB - bodyA) / (count - 1) : 0;
const sagitta = arcDip - arcEnd;
const radius = (500 * 500 + sagitta * sagitta) / (2 * sagitta);
const arcY = (x: number) => arcDip - (radius - Math.sqrt(radius * radius - (x - 500) ** 2));
const bodies = projects.map((project, index) => {
  const x = count > 1 ? bodyA + index * step : 50;
  return { project, index, x: x.toFixed(2), y: arcY(x * 10).toFixed(2), share: count > 1 ? (index / (count - 1)).toFixed(3) : '0.5' };
});
// The arc itself, as an arc command from edge to edge (an ellipse once the box is stretched).
const arcPath = `M0 ${arcEnd} A${radius.toFixed(1)} ${radius.toFixed(1)} 0 0 0 1000 ${arcEnd}`;
// Each slide carries its focal point so the crop and the settle-in zoom agree.
const focus = (value?: string) => { const [x, y] = (value ?? '50% 44%').split(' '); return `--fx:${x};--fy:${y}`; };
// A contained slide letterboxes over a blurred copy of its own image.
const stageImage = (project: typeof projects[number]) => project.data.stageFit === 'contain' ? `;--stage-image:url("${project.data.image}")` : '';
---
{count > 0 && <section class:list={['hero', 'reel', {'reel--dense': dense}]} role="region" aria-label="Featured projects" aria-roledescription="carousel" style={`--body-a:${bodyA / 100};--body-step:${(step / 100).toFixed(4)};--arc-end:${arcEnd / 100};--arc-dip:${arcDip / 100}`}>
  <div class="stage">
    {projects.map((project,index) => <div class:list={['reel-slide', {'is-active': index === 0, 'reel-slide--contain': project.data.stageFit === 'contain'}]} style={focus(project.data.imageFocus) + stageImage(project)} data-slide aria-hidden={index !== 0} inert={index !== 0} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${count}: ${project.data.title}`}>
      {project.data.video
        ? <video src={project.data.video} poster={project.data.image} muted loop playsinline autoplay preload={index === 0 ? 'auto' : 'metadata'} aria-label={`${project.data.title} preview`} width="1200" height="600"></video>
        : <img src={project.data.image} alt={`${project.data.title} preview`} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} width="1200" height="600" />}
    </div>)}
    <div class="stage-scrim" aria-hidden="true"></div>
    <div class="stage-caption">
      {/* Every readout sits in the same grid cell, anchored to the stage's bottom edge, so the caption never moves as the reel turns; the script crossfades them. */}
      <div class="reel-readouts">
        {projects.map((project,index) => <div class:list={['reel-readout', {'is-active': index === 0}]} data-readout={index} data-project-category={project.data.section} aria-hidden={index !== 0} inert={index !== 0}>
          <p class="reel-kicker"><span class="reel-category">{categories[project.data.section]}</span><span class:list={['status', {'status--progress': project.data.unpublished}]}>{project.data.unpublished ? 'In progress' : 'Live'}</span></p>
          <h2>{project.data.title}</h2>
        </div>)}
      </div>
      <div class="reel-cta">
        {projects.map((project,index) => {
          const link = project.data.links.find(link => link.primary) || project.data.links[0];
          const cta = ctaLabel(project.data.section);
          return link && <a class:list={['reel-open', {'is-active': index === 0}]} data-readout={index} aria-hidden={index !== 0} inert={index !== 0} href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`${cta}: ${project.data.title} (opens in a new tab)`}>{cta} <ExternalLinkIcon /></a>;
        })}
      </div>
    </div>
  </div>
  <div class="instrument" hidden>
    {/* The bezel unrolled: a tick rail under the stage, the slide timer's sweep along its top edge, and the hand that slides to the active body. */}
    <div class="rail" aria-hidden="true">
      <span class="reel-sweep"></span>
      <span class="rail-hand"></span>
    </div>
    <div class="arc">
      <svg class="arc-line" viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="ring arc-path" d={arcPath} pathLength="1" vector-effect="non-scaling-stroke" />
      </svg>
      <div class="arc-bodies" role="group" aria-label="Choose featured project">
        {bodies.map(({project,index,x,y,share}) => <button type="button" class="orbit-body" style={`--x:${x}%;--y:${y};--share:${share}`} data-slide-to={index} aria-pressed={index === 0}><span class="orbit-body-title">{project.data.title}</span><span class="orbit-body-meta">{categories[project.data.section]}</span></button>)}
      </div>
    </div>
    <div class="reel-actions">
      <button type="button" data-reel-prev aria-label="Previous project"><svg class="ui-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5"/></svg></button>
      <button type="button" data-reel-play aria-label="Pause slideshow"><svg class="ui-icon icon-pause" viewBox="0 0 20 20" aria-hidden="true"><rect x="5" y="4" width="3.5" height="12" rx="1"/><rect x="11.5" y="4" width="3.5" height="12" rx="1"/></svg><svg class="ui-icon icon-play" viewBox="0 0 20 20" aria-hidden="true"><path d="M6.5 4.6v10.8a.6.6 0 0 0 .9.5l8.4-5.4a.6.6 0 0 0 0-1L7.4 4.1a.6.6 0 0 0-.9.5Z"/></svg></button>
      <button type="button" data-reel-next aria-label="Next project"><svg class="ui-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5"/></svg></button>
    </div>
  </div>
</section>}
<script>
  const reel = document.querySelector<HTMLElement>('.reel');
  if (reel) {
    const slides = Array.from(reel.querySelectorAll<HTMLElement>('[data-slide]'));
    const selectors = Array.from(reel.querySelectorAll<HTMLButtonElement>('[data-slide-to]'));
    const readouts = Array.from(reel.querySelectorAll<HTMLElement>('[data-readout]'));
    const play = reel.querySelector<HTMLButtonElement>('[data-reel-play]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const root = document.documentElement;
    let current = 0;
    let paused = reduced.matches;
    let hovering = false;
    let started = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    function schedule() {
      clearTimeout(timer);
      reel!.classList.remove('is-playing');
      // The sweep waits for the arrival (the instrument winding up) to finish.
      if (paused || hovering || document.hidden || slides.length < 2 || root.classList.contains('is-arriving')) return;
      // Restart the rail sweep with the slide timer.
      void reel!.offsetWidth;
      // A video slide holds long enough to finish one loop.
      const video = slides[current].querySelector('video');
      if (video && !video.duration) video.addEventListener('loadedmetadata', schedule, { once: true });
      const delay = video ? Math.round((video.duration || 20) * 1000) + 300 : 6500;
      reel!.style.setProperty('--reel-delay', `${delay}ms`);
      reel!.classList.add('is-playing');
      timer = setTimeout(() => show(current + 1), delay);
    }
    function show(index: number) {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide,i) => {
        slide.classList.toggle('is-active', i === current);
        slide.inert = i !== current;
        slide.setAttribute('aria-hidden', String(i !== current));
      });
      selectors.forEach((button,i) => {
        button.setAttribute('aria-pressed', String(i === current));
        // On a crowded arc only the active body and its neighbours show their titles.
        button.classList.toggle('is-near', Math.abs(i - current) === 1);
      });
      // Readouts and CTAs stay in flow so they can crossfade; only the active one is exposed.
      readouts.forEach(readout => {
        const active = Number(readout.dataset.readout) === current;
        readout.classList.toggle('is-active', active);
        readout.inert = !active;
        readout.setAttribute('aria-hidden', String(!active));
      });
      // After the first turn the readout crossfades as it changes; on load it is simply there.
      if (started) reel!.classList.add('has-turned');
      // The hand slides along the rail to sit over the active body.
      reel!.style.setProperty('--reel-index', String(current));
      // Only the visible slide's video plays; reduced-motion users get the poster.
      slides.forEach((slide,i) => {
        const video = slide.querySelector('video');
        if (!video) return;
        if (i === current && !reduced.matches) video.play().catch(() => {}); else video.pause();
      });
      schedule();
    }
    function setPaused(value: boolean) {
      paused = value;
      // The button holds both icons; the class decides which one shows.
      play.classList.toggle('is-paused', paused);
      play.setAttribute('aria-label', paused ? 'Play slideshow' : 'Pause slideshow');
      schedule();
    }
    selectors.forEach((button,i) => button.addEventListener('click', () => { setPaused(true); show(i); }));
    reel.querySelector('[data-reel-prev]')?.addEventListener('click', () => { setPaused(true); show(current - 1); });
    reel.querySelector('[data-reel-next]')?.addEventListener('click', () => { setPaused(true); show(current + 1); });
    let pausedBeforePointer = paused;
    play.addEventListener('pointerdown', () => { pausedBeforePointer = paused; });
    play.addEventListener('click', event => setPaused(event.detail > 0 ? !pausedBeforePointer : !paused));
    reel.addEventListener('mouseenter', () => { hovering = true; schedule(); });
    reel.addEventListener('mouseleave', () => { hovering = false; schedule(); });
    // Keyboard interaction stops rotation until explicitly restarted.
    reel.addEventListener('focusin', () => setPaused(true));
    document.addEventListener('visibilitychange', schedule);
    reduced.addEventListener('change', () => { if (reduced.matches) setPaused(true); });
    reel.querySelector<HTMLElement>('.instrument')!.hidden = slides.length < 2;
    setPaused(paused);
    show(current);
    started = true;
    // The arrival (see "Arrival" in portfolio.css): the head sets is-arriving
    // before first paint. It comes off when the hand settles, or at the first
    // pointer or key on the instrument so a person is never made to wait; the
    // hand then eases from wherever it was. Either way the sweep starts here.
    const hand = reel.querySelector<HTMLElement>('.rail-hand');
    function arrive() {
      if (!root.classList.contains('is-arriving')) return;
      // A transition does not pick up where a cancelled animation left off, so
      // the hand's current position is held inline for one style pass and the
      // transition to wherever the reel points starts from there.
      if (hand) {
        const m = getComputedStyle(hand).transform.match(/matrix\(([^)]+)\)/);
        if (m) hand.style.transform = `translateX(${Number(m[1].split(',')[4])}px)`;
      }
      root.classList.remove('is-arriving');
      if (hand) { void hand.getBoundingClientRect(); hand.style.transform = ''; }
      schedule();
    }
    if (root.classList.contains('is-arriving')) {
      hand?.addEventListener('animationend', event => { if (event.target === hand) arrive(); });
      reel.addEventListener('pointerdown', arrive, { capture: true });
      reel.addEventListener('keydown', arrive, { capture: true });
      setTimeout(arrive, 1600);
    }
  }
</script>
