---
// The night ground behind the fold: a hand-placed starfield in three depths
// (far, mid, near) that runs the full height of the fold, and three meteors on
// their own paths. The header band is kept clear in CSS (see .sky-stars).
// Purely decorative.
const far = [[120,60],[260,140],[410,48],[540,210],[700,90],[860,40],[980,130],[1130,60],[1290,110],[1450,50],[1560,170],[1520,300],[1580,470],[1470,640],[1380,820],[1180,860],[940,840],[760,780],[620,640],[300,720],[150,560],[70,330],[440,470],[830,300],[1020,470],[1240,560],[680,520],[1090,760],[40,880],[210,600],[390,890],[570,700],[760,880],[950,590],[1120,700],[1310,870],[1480,760],[1590,540],[110,690],[640,820],[1230,650],[1550,850]];
const mid = [[200,240],[660,160],[1060,90],[1240,300],[1600,700],[50,760],[360,860],[900,720],[1500,880],[720,420],[1340,180],[90,120],[560,320],[1440,420],[300,640],[820,600],[1400,760],[1000,640],[160,820],[1560,880]];
const near = [[330,90],[1180,40],[1430,240],[770,240],[240,620],[1590,600],[1030,880],[480,780],[700,690],[1250,840],[60,600]];
---
<div class="sky" aria-hidden="true">
  <svg class="sky-stars" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" focusable="false">
    <g class="stars-far">{far.map(([x,y]) => <circle cx={x} cy={y} r="1" />)}</g>
    <g class="stars-mid">{mid.map(([x,y]) => <circle cx={x} cy={y} r="1.6" />)}</g>
    <g class="stars-near">{near.map(([x,y]) => <circle cx={x} cy={y} r="2.3" />)}</g>
  </svg>
  <span class="sky-meteor sky-meteor--band"></span>
  <span class="sky-meteor sky-meteor--long"></span>
  <span class="sky-meteor sky-meteor--low"></span>
</div>
