---
import ExternalLinkIcon from '../components/ExternalLinkIcon.astro';
import '../styles/portfolio.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import ProjectCarousel from '../components/ProjectCarousel.astro';
import SkyField from '../components/SkyField.astro';
import Closing from '../components/Closing.astro';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
// Social previews need an absolute image URL; fall back to the path when no site is configured.
const shareImage = Astro.site ? new URL('/images/antikythera.png', Astro.site).href : '/images/antikythera.png';
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f3f4fa" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e1128" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={shareImage} />
  {pageUrl && <meta property="og:url" content={pageUrl} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" href="/fonts/bricolage-grotesque-latin-opsz.woff2" as="font" type="font/woff2" crossorigin />
  <script is:inline>
    try { var saved = localStorage.getItem('theme'); if (saved === 'light' || saved === 'dark') document.documentElement.setAttribute('data-theme', saved); } catch (_) {}
    // The arrival: the instrument winds up on first paint (see "Arrival" in portfolio.css). Set here so the first frame already holds its starting state; never set under reduced motion.
    try { if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('is-arriving'); } catch (_) {}
  </script>
</head>
<body>
<a class="skip-link" href="#projects">Skip to projects</a>
<header class="site-header-band">
  <div class="site site-header">
    <div class="brand">
      <a class="mark" href="#" aria-label="Cameron Loveland home"><svg viewBox="0 0 28 28" aria-hidden="true" focusable="false"><circle cx="14" cy="14" r="11"/><circle class="mark-core" cx="14" cy="14" r="2.6"/><circle class="mark-body" cx="21.07" cy="5.57" r="2"/></svg></a>
      <div class="wordmark">
        <h1 class="wordmark-name"><span>Cameron</span> <span>Loveland</span></h1>
        <p class="wordmark-role">Software engineer making games, apps and experiments.</p>
      </div>
    </div>
    <nav class="header-links" aria-label="Site links">
      <a href="https://github.com/cameronloveland" target="_blank" rel="noopener noreferrer">GitHub <ExternalLinkIcon /></a>
      <a href="https://www.linkedin.com/in/cameron-loveland/" target="_blank" rel="noopener noreferrer">LinkedIn <ExternalLinkIcon /></a>
      <ThemeToggle />
    </nav>
  </div>
</header>
<main>
  <div class="fold">
    <SkyField />
    <div class="site">
      <ProjectCarousel />
    </div>
  </div>
  <div class="site">
    <div id="projects" class="work-area"><slot /></div>
  </div>
  <Closing />
</main>
<footer class="site-footer">
  <div class="site footer-grid">
    <div class="footer-signature">
      <p class="footer-wordmark"><svg class="footer-mark" viewBox="0 0 28 28" aria-hidden="true" focusable="false"><circle cx="14" cy="14" r="11"/><circle class="mark-core" cx="14" cy="14" r="2.6"/><circle class="mark-body" cx="21.07" cy="5.57" r="2"/></svg><span class="footer-name"><span>Cameron</span> <span>Loveland</span></span></p>
      <p class="footer-role">Software engineer making games, apps and experiments.</p>
    </div>
    <nav class="footer-links" aria-label="Footer links">
      <p class="footer-links-label" id="footer-elsewhere">Elsewhere</p>
      <ul aria-labelledby="footer-elsewhere">
        <li><a href="https://github.com/cameronloveland" target="_blank" rel="noopener noreferrer">GitHub<ExternalLinkIcon /></a></li>
        <li><a href="https://www.linkedin.com/in/cameron-loveland/" target="_blank" rel="noopener noreferrer">LinkedIn<ExternalLinkIcon /></a></li>
      </ul>
      <p class="footer-links-label" id="footer-this-site">This site</p>
      <ul aria-labelledby="footer-this-site">
        <li><a href="https://github.com/cameronloveland/cameronloveland.github.io" target="_blank" rel="noopener noreferrer">Source code<ExternalLinkIcon /></a></li>
        <li><a href="#">Back to top<svg class="ui-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 16V4M5 9l5-5 5 5"/></svg></a></li>
      </ul>
    </nav>
    <p class="footer-colophon">Built with Astro as a static site. Plain CSS, no client framework, no tracking. Set in Bricolage Grotesque.</p>
    <p class="footer-copyright">&copy; {new Date().getUTCFullYear()} Cameron Loveland</p>
  </div>
</footer>
</body>
</html>
